        '        Console.WriteLine("Value for " & p.PropertyName)
        '    Else
        '        Console.WriteLine("No value for " & p.PropertyName)
        '    End If

        '    _PropertyCollection.Add(AnAttribute)
        'Next

        rc = Nothing
        OneUser.Close()
        OneUser.Dispose()
        ds.Dispose()

    End Sub

