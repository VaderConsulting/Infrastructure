    Public Sub BuildAttributeList(ByVal DirectoryRoot As String)
        _DirectoryRoot = DirectoryRoot
        BuildAttributeList()
    End Sub

    Public Sub BuildAttributeList()
        If _DirectoryRoot.Length = 0 Then Exit Sub

        Dim ds As New DirectorySearcher

        ds.Filter = "(objectclass=user)"
        ds.SearchScope = SearchScope.Subtree

        'Perform search to find just a single user
        Dim rc As SearchResult = ds.FindOne()
        Dim OneUser As DirectoryEntry = rc.GetDirectoryEntry

        _PropertyCollection.Clear()

        'For Each p As PropertyValueCollection In OneUser.Properties
        '    Dim AnAttribute As New CustomAttribute(p.PropertyName)

        '    If OneUser.Properties.Contains(p.PropertyName) Then
